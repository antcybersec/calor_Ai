# CalorAI Environment Variables

# Copy this file to .env and fill in your keys.

# --- Required ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Model Selection ---
# Text model: lightweight, fast, optimized for tool-calling & conversation
DEFAULT_TEXT_MODEL=gemini-3.5-flash-lite
# Vision model: more capable model for spatial food recognition & portion estimation
DEFAULT_VISION_MODEL=gemini-3.5-flash

# --- LangSmith Tracing (optional but recommended) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=calor-ai-logging-agent

# --- Database ---
DATABASE_PATH=calor_ai.db

